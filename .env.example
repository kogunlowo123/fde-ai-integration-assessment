# Example configuration for the FDE assessment services.
#
# Generated by `python scripts/gen_env_example.py`, edit that script's
# section map, not this file, and never put a real secret here.
#
# The values below are the application defaults. The credentials are published
# development values: `Settings` refuses to start with APP_ENV=production while
# any of them is still in place.

# --- Application -------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
BIND_HOST=127.0.0.1

# --- Service ports -----------------------------------------------------
MCP_GATEWAY_PORT=8000
LLM_GATEWAY_PORT=8001

# --- Persistence (Task 4 requires on-disk SQLite) ----------------------
DATABASE_PATH=data/gateway.db

# --- MCP security gateway (Task 2) -------------------------------------
MCP_DOWNSTREAM_URL=http://127.0.0.1:9000/rpc
MCP_DOWNSTREAM_TIMEOUT_MS=5000
MCP_GATEWAY_MAX_BODY_BYTES=262144
MCP_GATEWAY_TOKENS=dev-admin-token:admin,dev-viewer-token:viewer
ADMIN_TOOL_PREFIX=admin_

# --- LLM gateway identity and limits (Tasks 3 + 4) ---------------------
LLM_GATEWAY_TENANTS=dev-tenant-a-key:tenant-a,dev-tenant-b-key:tenant-b
API_KEY_PEPPER=dev-only-pepper-not-a-secret
LLM_GATEWAY_MAX_BODY_BYTES=1048576
MAX_OUTPUT_TOKENS=1024
MAX_PROMPT_CHARS=100000

# --- Model routing and fallback (Task 4) -------------------------------
PRIMARY_PROVIDER=mock
PRIMARY_MODEL=mock-primary
PRIMARY_TIMEOUT_MS=3000
SECONDARY_PROVIDER=mock
SECONDARY_MODEL=mock-secondary
SECONDARY_TIMEOUT_MS=10000

# --- Token-aware rate limiting (Task 4) --------------------------------
RATE_LIMIT_TOKENS=50000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BUSY_TIMEOUT_MS=5000

# --- Streaming PII guardrail (Task 3) ----------------------------------
PII_CARRY_BUFFER_CHARS=128

# --- Ollama -- optional local models, never used in CI -----------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- RAG (Production Enhancement) --------------------------------------
RAG_EMBEDDING_PROVIDER=mock
RAG_EMBEDDING_DIM=256
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_DEFAULT_TOP_K=4
RAG_MAX_TOP_K=10
RAG_MAX_CONTEXT_CHARS=6000
